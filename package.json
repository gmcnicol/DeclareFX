{
  "name": "declarefx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Declare-authored interfaces compiled to standalone JSFX.",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "24.16.0",
    "pnpm": "12.23.0"
  },
  "bin": {
    "declarefx": "dist/src/cli.js"
  },
  "scripts": {
    "declarefx": "node dist/src/cli.js",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm clean && tsc",
    "check": "tsc --noEmit",
    "test": "pnpm build && node --test \"dist/test/**/*.test.js\"",
    "verify:vendor": "pnpm build && node --test dist/test/vendor.test.js"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1"
  }
}
